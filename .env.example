# Copy to .env (git-ignored) and fill in. Gradle reads these KEY=value lines at build time.

# Developer credentials for Xross, issued by ScreenScraper (request them on the screenscraper.fr forum).
# Every API call needs these; without them ScreenScraper shows as unavailable in Settings.
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=

# Optional: a SteamGridDB API key (steamgriddb.com > Preferences > API) for hero banners, capsules
# and logos. Pre-filled in debug builds only. SteamGridDB_API= is accepted too.
STEAMGRIDDB_API_KEY=

# Optional: your own ScreenScraper account (raises your quotas). Pre-filled in debug builds only.
# The login is your ScreenScraper user name (shown on your profile), not your email.
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
