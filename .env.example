# Copy to .env (git-ignored) and fill in. Gradle reads these KEY=value lines at build time.

# Developer credentials for Xross, issued by ScreenScraper (request them on the screenscraper.fr forum).
# Every API call needs these; without them ScreenScraper shows as unavailable in Settings, and a
# release build refuses to run (override with -PallowNoScreenScraper=true). They are baked into the
# APK in masked form so users never need their own; they never belong in the repository.
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=

# Optional: a SteamGridDB API key (steamgriddb.com > Preferences > API) for hero banners, capsules
# and logos. Pre-filled in debug builds only. SteamGridDB_API= is accepted too.
STEAMGRIDDB_API_KEY=

# Optional: your own ScreenScraper account (raises your quotas). Pre-filled in debug builds only.
# The login is your ScreenScraper user name (shown on your profile), not your email.
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=

# Optional: RetroAchievements. Debug builds link the account on a fresh install from the user name
# and Web API key (retroachievements.org > Settings > Keys). The password is only used by
# RetroAchievementsLiveTest to check the account signs in; the app never reads it.
RETROACHIEVEMENTS_USER=
RETROACHIEVEMENTS_WEB_API_KEY=
RETROACHIEVEMENTS_PASSWORD=

# Release signing (assembleRelease). Without these the release APK is unsigned.
XROSS_KEYSTORE=
XROSS_KEYSTORE_PASSWORD=
XROSS_KEY_ALIAS=
XROSS_KEY_PASSWORD=
