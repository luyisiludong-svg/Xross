// BREAKCORE.ERR: a breakcore / glitchcore / Y2K-brutalist background for Xross.
//
// Everything is drawn on a coarse pixel grid and then broken on purpose, in time with a 172 BPM
// breakbeat the shader keeps itself (and with the music, when Xross's player is on):
//   a posterised plasma under a brutalist layout grid with registration crosses,
//   the word BREAKCORE in giant half-tone pixel type,
//   a chrome four-point Y2K star with an orbit ring and twinkles,
//   a perspective checkerboard floor that scrolls and bounces on the kick,
//   a hazard-tape ticker along the bottom and a vertical warning tape on the right,
//   up to three OS error popups that pop in on the beat (inverse title bar, X box, OK button,
//   hard shadow), a REC timecode, and corrupt macroblocks.
// Then the glitch: slice tears, RGB split, retriggered (stuttered) time, datamosh blocks that
// smear last frame's picture, a few inverted bands on the snare, and a Bayer-dithered bitcrush.
//
// Passes:
//   uPass 0 (uField, one texel per 4x4 pixels) draws the whole scene at quarter size. That is
//          the pixel grid: one font dot, one floor pixel, one popup pixel is one texel.
//   uPass 1 (full size) tears, splits, moshes (uPrev), bitcrushes and dims the menu's side.
//
// Uniforms used: uTime, uResolution, uColorTop / uColorBottom (canvas), uAccent (acid: tapes,
// floor lines), uGlow (hot: popups, ring, side tape), uBatteryLevel (LOW POWER popups and a red
// pulse under 20%), uAudioBass (pumps the floor, star and split), uAudioBeat and uTransition
// (glitch bursts: a category switch, and the cold-start SHADER intro), uPrev / uFrameDt / uFresh.
//
// Calm by design: most bars play clean. Glitches are small, rare and short, the kick no longer
// moves the picture, tickers crawl, popups stay for 24 beats, and nothing inverts or flashes.
// The big burst is kept for a category switch and the cold-start intro only.

const float BPM = 172.0;
const vec3 INK = vec3(0.02, 0.015, 0.03);
const vec3 WHITE = vec3(1.0);
const vec3 CHROME = vec3(0.78, 0.80, 0.86);
const vec3 CYAN = vec3(0.10, 0.92, 1.00);
const float MENU_DIM = 0.35;     // brightness kept behind the category column (left side)
const float LEVELS = 7.0;        // bitcrush: levels per channel before dithering
const float PERSIST = 0.06;      // half-life of the afterglow, seconds

// @FONT generated by BREAKCORE_ERR_tools/gen_font.py, do not edit by hand
// glyph order: ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789./?!:-#*+><=@
const int FONT[49] = int[](
    18415150, 16301615, 31491134, 16303663, 32554047, 1096767, 32039998, 18415153, 32641183, 6594844,
    18128177, 32539681, 18405233, 18667121, 15255086, 1097263, 23385646, 18136623, 16267326, 4329631,
    15255089, 4539953, 18732593, 18157905, 4329809, 32575775, 15324974, 14815428, 32553487, 16267791,
    8682793, 16268351, 15252526, 2167071, 15252014, 15235630, 4194304, 1118480, 4207119, 4198532,
    131200, 14336, 11512810, 22511061, 4357252, 2236546, 8521864, 1016800, 33554431);
const int STR[224] = int[](
    1, 17, 4, 0, 10, 2, 14, 17, 4, 36, 4, 17, 17, -1, 37, 37, 37, -1, 18, 8, 6, 13, 0, 11,
    -1, 11, 14, 18, 19, -1, 37, 37, 37, -1, 27, 33, 28, -1, 1, 15, 12, -1, 37, 37, 37, -1, 13, 14,
    -1, 2, 0, 17, 17, 8, 4, 17, -1, 37, 37, 37, -1, 24, 28, 10, -1, 14, 10, 38, -1, 37, 37, 37,
    -1, 17, 0, 21, 4, 36, 4, 23, 4, -1, 7, 0, 18, -1, 18, 19, 14, 15, 15, 4, 3, -1, 37, 37,
    37, -1, 22, 0, 17, 13, 8, 13, 6, -1, 47, 47, 47, -1, 3, 14, -1, 13, 14, 19, -1, 15, 0, 13,
    8, 2, -1, 47, 47, 47, -1, 1, 20, 5, 5, 4, 17, -1, 14, 21, 4, 17, 17, 20, 13, -1, 47, 47,
    47, -1, 4, 17, 17, 36, 4, 23, 4, 5, 0, 19, 0, 11, -1, 4, 17, 17, 14, 17, 13, 14, -1, 18,
    8, 6, 13, 0, 11, 10, 4, 17, 13, 4, 11, -1, 1, 17, 4, 0, 10, 1, 20, 5, 5, 4, 17, -1,
    45, 45, 45, 17, 4, 19, 17, 24, 38, 11, 14, 22, -1, 15, 14, 22, 4, 17, 14, 10, 1, 17, 4, 0,
    10, 2, 14, 17, 4, 17, 4, 2);
const int STR_OFF[12] = int[](0, 98, 146, 153, 164, 173, 185, 195, 201, 210, 212, 221);
const int STR_LEN[12] = int[](98, 48, 7, 11, 9, 12, 10, 6, 9, 2, 9, 3);
// @FONT end

// ---------------------------------------------------------------------------------------------
// Hashes and helpers

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

float hash21(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

mat2 rot(float a) {
    float c = cos(a), s = sin(a);
    return mat2(c, -s, s, c);
}

// Glyph g's dot at (x, y), y down from the top; 0 outside its 5x5 box or for a space (-1).
float dot5(int g, int x, int y) {
    if (g < 0 || x < 0 || y < 0 || x > 4 || y > 4) return 0.0;
    return float((FONT[g] >> (y * 5 + x)) & 1);
}

// String s set once from (0, 0), 6 cells per character.
float textDot(int s, int x, int y) {
    if (x < 0 || y < 0 || y > 4) return 0.0;
    int ci = x / 6;
    if (ci >= STR_LEN[s]) return 0.0;
    return dot5(STR[STR_OFF[s] + ci], x - ci * 6, y);
}

// String s repeated forever along x.
float tickerDot(int s, float x, int y) {
    if (y < 0 || y > 4) return 0.0;
    int n = STR_LEN[s] * 6;
    int xi = int(mod(floor(x), float(n)));
    int ci = xi / 6;
    return dot5(STR[STR_OFF[s] + ci], xi - ci * 6, y);
}

// Airbrushed chrome: sky on top, a dark horizon line, warm ground below. v: 0 bottom .. 1 top.
vec3 chrome(float v) {
    vec3 ground = mix(vec3(0.28, 0.22, 0.30), vec3(0.92, 0.88, 0.90), smoothstep(0.0, 0.46, v));
    vec3 sky = mix(vec3(0.45, 0.70, 1.00), vec3(1.0), smoothstep(0.55, 1.0, v));
    vec3 c = v < 0.5 ? ground : sky;
    return mix(c, vec3(0.04, 0.04, 0.12), smoothstep(0.42, 0.5, v) * (1.0 - smoothstep(0.5, 0.6, v)));
}

// ---------------------------------------------------------------------------------------------
// The breakbeat clock. 16 steps a bar: kick on 0 3 8 10, snare on 4 12, ghosts on 7 14, and a
// snare roll over the second half of most fourth bars.

struct Clock {
    float beat;   // beats since the start
    float s16;    // 16th-note index
    float f16;    // 0..1 through the current 16th
    float kick;   // envelopes, 1 at the hit
    float snare;  // the main snare only (drives the inverted bands)
    float roll;   // the fill's snare roll
    float fill;   // 1 during a fill bar
    float hit;    // how hard the picture breaks right now, 0..2
};

Clock clockAt(float t) {
    Clock c;
    c.beat = t * BPM / 60.0;
    c.s16 = floor(c.beat * 4.0);
    c.f16 = fract(c.beat * 4.0);
    int st = int(mod(c.s16, 16.0));
    float bar = floor(c.beat / 4.0);
    float e = exp(-c.f16 * 2.5);
    c.kick = float((1289 >> st) & 1) * e;
    c.snare = float((4112 >> st) & 1) * e;
    float ghost = float((16512 >> st) & 1) * e * 0.4;
    c.fill = (mod(bar, 4.0) == 3.0 && hash11(bar * 1.91) > 0.75) ? 1.0 : 0.0;
    c.roll = c.fill * (st >= 8 ? e : 0.0);
    float low = uBatteryLevel < 0.2 ? 0.15 : 0.0;
    c.hit = clamp(c.snare * 0.3 + c.roll * 0.25 + ghost * 0.0 + uAudioBeat * 0.3
        + uTransition * 1.0 + low, 0.0, 2.0);
    return c;
}

// Stutter: some 16ths retrigger their first third three times, a few freeze.
float sceneTime(Clock c) {
    float h = hash11(c.s16 * 1.37 + 3.0);
    float dur = 15.0 / BPM;
    float t0 = c.s16 * dur;
    if (h > 0.985 || (c.fill > 0.5 && h > 0.9)) return t0 + fract(c.f16 * 3.0) * dur / 3.0;
    if (h < 0.01) return t0;
    return uTime;
}

// ---------------------------------------------------------------------------------------------
// Pass 0: the scene, one texel per 4x4 pixels.
//   tx: texel, bottom-up; q: the same texel with y top-down; S: texels across and down.

vec3 scene(ivec2 tx, ivec2 S, vec2 uv, float t, Clock c) {
    ivec2 q = ivec2(tx.x, S.y - 1 - tx.y);
    vec3 top = uColorTop.rgb, bot = uColorBottom.rgb, A = uAccent.rgb, G = uGlow.rgb;
    float aspect = uResolution.x / uResolution.y;
    float texel = 4.0 / uResolution.y;   // one texel in uv
    bool lowBatt = uBatteryLevel < 0.2;

    // Posterised plasma over the canvas gradient.
    vec3 col = mix(bot, top, clamp(uv.y + 0.5, 0.0, 1.0)) * 0.6;
    float pl = sin(uv.x * 2.3 + t * 0.45) + sin(uv.y * 4.1 - t * 0.8 + 2.0 * sin(uv.x * 1.7 + t * 0.25));
    float bnd = floor((pl * 0.25 + 0.5) * 4.0) / 4.0;
    col += G * 0.10 * bnd + A * 0.03 * (1.0 - bnd);

    // Brutalist layout grid and registration crosses.
    ivec2 m = q % 24;
    if (m.x == 0 || m.y == 0) col = mix(col, CHROME, 0.06);
    ivec2 m2 = (q + 2) % 48;
    if ((m2.x == 2 && m2.y < 5) || (m2.y == 2 && m2.x < 5)) col = mix(col, CHROME, 0.35);

    // BREAKCORE in giant half-tone type; it jumps sideways on stuttered 16ths.
    {
        int sc = 4;
        float jump = hash11(c.s16 * 0.77) > 0.98 ? floor((hash11(c.s16 * 2.3) - 0.5) * 24.0) : 0.0;
        int wx = q.x - (S.x - 9 * 6 * sc - 8) - int(jump);
        int wy = q.y - int(float(S.y) * 0.40);
        if (wx >= 0 && wy >= 0 && wy < 5 * sc && textDot(10, wx / sc, wy / sc) > 0.0) {
            float ht = float((q.x + q.y) & 1);
            col = mix(col, mix(top * 2.0 + G * 0.2, A * 0.6, c.snare), 0.45 + 0.25 * ht);
        }
    }

    // Checkerboard floor in perspective, scrolling half a tile a beat.
    float hz = -0.10 + 0.003 * c.kick + 0.006 * uAudioBass;
    if (uv.y < hz) {
        float d = hz - uv.y;
        float z = 0.22 / d;
        vec2 f = vec2(uv.x * z * 3.0, z * 1.5 + c.beat * 0.125);
        float chk = mod(floor(f.x) + floor(f.y), 2.0);
        vec3 fl = mix(INK, bot * 0.6 + G * 0.08, chk);
        vec2 gl = abs(fract(f) - 0.5);
        vec2 w = fwidth(f);
        float line = max(step(0.5 - w.x * 0.9, gl.x), step(0.5 - w.y * 0.9, gl.y));
        fl = mix(fl, A * (0.55 + 0.1 * c.kick), line * 0.85 * smoothstep(0.015, 0.12, d));
        col = mix(top * 0.4 + G * 0.18, fl, smoothstep(0.0, 0.18, d));
    }
    if (abs(uv.y - hz) < texel * 0.6) col = G;

    // Chrome star with an orbit ring (back half behind, front half over) and twinkles.
    {
        vec2 cs = vec2(max(0.5 * aspect - 0.34, 0.05), 0.07);
        float R = 0.20 * (1.0 + 0.03 * c.kick + 0.06 * uAudioBass);
        vec2 rp = (uv - cs) / R;
        float ring = step(abs(length(rp * vec2(1.0, 3.2)) - 1.55), 0.06);
        if (ring > 0.0 && rp.y > 0.0) col = mix(col, G, 0.8);
        vec2 sp = rot(t * 0.12) * rp;
        float st = sqrt(abs(sp.x)) + sqrt(abs(sp.y));
        if (st < 1.0) {
            vec3 ch = chrome(clamp(rp.y * 0.6 + 0.5, 0.0, 1.0));
            if (st > 0.86) ch = mix(ch, WHITE, 0.6);
            col = ch * 0.85;
        }
        if (ring > 0.0 && rp.y <= 0.0) col = mix(col, G, 0.9);
        for (int i = 0; i < 2; i++) {
            float k = floor(c.beat / 8.0) + float(i) * 13.0;
            vec2 sv = cs + (vec2(hash11(k * 1.1), hash11(k * 2.7)) - 0.5) * R * 4.0;
            ivec2 sq = ivec2(floor((sv * uResolution.y + 0.5 * uResolution) / 4.0));
            ivec2 dq = abs(tx - sq);
            if ((dq.x == 0 && dq.y <= 2) || (dq.y == 0 && dq.x <= 2)) col = mix(col, WHITE, 0.7 * sin(3.14159 * fract(c.beat / 8.0)));
        }
    }

    // Hazard tape ticker along the bottom (texel rows 4..12); inverted during fills.
    if (tx.y >= 4 && tx.y <= 12) {
        int r = 12 - tx.y;
        float scroll = t * 12.0;
        vec3 bg = A * 0.85, fg = INK;
        if (c.fill > 0.5) { bg = INK; fg = A; }
        vec3 tc = bg;
        if (r == 0 || r == 8) tc = ((int(mod(float(q.x + r) + scroll, 6.0))) < 3) ? INK : A;
        else if (r == 1 || r == 7) tc = INK;
        else tc = mix(bg, fg, tickerDot(0, float(q.x) + scroll, r - 2));
        col = tc;
    }

    // Vertical warning tape on the right edge, reading upward.
    {
        int r = q.x - (S.x - 11);
        if (r >= 0 && r <= 8) {
            float a = float(tx.y) + t * 8.0;
            vec3 tc = G;
            if (r == 0 || r == 8) tc = (int(mod(a + float(r), 6.0)) < 3) ? INK : WHITE;
            else if (r == 1 || r == 7) tc = INK;
            else tc = mix(G, WHITE, tickerDot(1, a, r - 2));
            col = tc * 0.9;
        }
    }

    // REC timecode above the ticker: "@ REC HH:MM:SS".
    {
        int lx = q.x - (S.x - 14 - 14 * 6);
        int ly = q.y - (S.y - 21);
        if (lx >= 0 && ly >= 0 && ly <= 4 && lx < 14 * 6) {
            int ci = lx / 6;
            int secs = int(t);
            int hh = (secs / 3600) % 100, mm = (secs / 60) % 60, ss = secs % 60;
            int g = -1;
            if (ci == 0) g = fract(uTime) < 0.5 ? 48 : -1;
            else if (ci >= 2 && ci <= 4) g = STR[STR_OFF[11] + ci - 2];
            else if (ci == 6) g = 26 + hh / 10;
            else if (ci == 7) g = 26 + hh % 10;
            else if (ci == 9) g = 26 + mm / 10;
            else if (ci == 10) g = 26 + mm % 10;
            else if (ci == 12) g = 26 + ss / 10;
            else if (ci == 13) g = 26 + ss % 10;
            else if (ci == 8 || ci == 11) g = 40;
            float d = dot5(g, lx - ci * 6, ly);
            if (d > 0.0) col = ci <= 4 ? vec3(1.0, 0.15, 0.12) : WHITE * 0.9;
        }
    }

    // Error popups: three slots, each a 6-beat cycle, shown for 4.5 beats at a new place.
    for (int i = 0; i < 2; i++) {
        float fi = float(i);
        float ph = c.beat / 32.0 + fi * 0.5;
        float ep = floor(ph);
        float age = fract(ph) * 32.0;
        if (age > 24.0) continue;
        int msg = lowBatt ? 8 : 3 + int(floor(hash11(ep * 1.3 + fi * 7.0) * 4.99));
        int w = max(STR_LEN[msg] * 6 + 9, 58);
        int hgt = 31;
        vec2 h = vec2(hash11(ep * 3.1 + fi * 17.0), hash11(ep * 5.7 + fi * 29.0));
        int x0 = int(mix(float(S.x) * 0.36, float(S.x - w - 14), h.x));
        int y0 = int(mix(14.0, float(S.y - hgt - 18), h.y));
                ivec2 l = ivec2(q.x - x0, q.y - y0);
        bool inside = l.x >= 0 && l.y >= 0 && l.x < w && l.y < hgt;
        if (!inside) {
            if (l.x >= 3 && l.y >= 3 && l.x < w + 3 && l.y < hgt + 3) col *= 0.15;   // hard shadow
            continue;
        }
        vec3 pc;
        if (l.x == 0 || l.y == 0 || l.x == w - 1 || l.y == hgt - 1) {
            pc = WHITE;
        } else if (l.y <= 8) {
            pc = mix(G, INK, textDot(2, l.x - 3, l.y - 2));
            if (l.x >= w - 10 && l.x <= w - 4 && l.y >= 1 && l.y <= 7)
                pc = mix(WHITE, INK, dot5(23, l.x - (w - 9), l.y - 2));   // the X box
        } else {
            pc = mix(INK * 0.5 + vec3(0.03), WHITE, textDot(msg, l.x - 4, l.y - 12));
            int bx = l.x - (w / 2 - 8), by = l.y - 21;
            if (bx >= 0 && bx < 17 && by >= 0 && by < 7) {   // bevelled OK button
                pc = CHROME;
                if (bx == 0 || by == 0) pc = WHITE;
                if (bx == 16 || by == 6) pc = vec3(0.25);
                pc = mix(pc, INK, textDot(9, bx - 3, by - 1));
            }
        }
        col = pc;
    }

    // Corrupt macroblocks.
    vec2 mb = floor(vec2(q) / vec2(8.0, 4.0));
    if (hash21(mb + c.s16 * 0.71) > 1.0 - (0.0004 + 0.012 * min(c.hit, 1.0))) {
        float k = hash21(mb * 1.9 + c.s16);
        vec3 junk = k < 0.33 ? A : (k < 0.66 ? G : CYAN);
        junk *= ((q.x + q.y * 3) % 4) < 2 ? 1.0 : 0.35;
        col = mix(col, junk, 0.85);
    }
    return col;
}

// ---------------------------------------------------------------------------------------------
// Pass 1: break it.

vec3 fieldAt(vec2 p, ivec2 fs) {
    ivec2 i = clamp(ivec2(floor(p / 4.0)), ivec2(0), fs - 1);
    return texelFetch(uField, i, 0).rgb;
}

float bayer4(vec2 p) {
    int i = int(mod(p.x, 4.0)) + int(mod(p.y, 4.0)) * 4;
    const float B[16] = float[](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);
    return (B[i] + 0.5) / 16.0;
}

void main() {
    Clock c = clockAt(uTime);
    ivec2 fs = ivec2(ceil(uResolution / 4.0));

    if (uPass == 0) {
        ivec2 tx = ivec2(floor(gl_FragCoord.xy));
        if (any(greaterThanEqual(vec2(tx) * 4.0, uResolution))) { fragColor = vec4(0.0); return; }
        vec2 px = (vec2(tx) + 0.5) * 4.0;
        vec2 uv = (px - 0.5 * uResolution) / uResolution.y;
        fragColor = vec4(scene(tx, fs, uv, sceneTime(c), c), 1.0);
        return;
    }

    vec2 p = gl_FragCoord.xy;
    vec2 res = uResolution;
    float hit = min(c.hit, 1.0);

    // Slice tears, snapped to the 4 px grid so the pixels stay square; they wrap round.
    float sliceH = floor(mix(4.0, 40.0, hash11(c.s16 * 3.1 + 1.0)));
    float sid = floor(p.y / sliceH);
    float tearOn = step(1.0 - (0.008 + 0.12 * hit), hash21(vec2(sid, c.s16)));
    float tear = tearOn * (hash21(vec2(sid * 1.3, c.s16 + 7.0)) - 0.5) * res.y * (0.02 + 0.12 * hit);
    tear = floor(tear / 4.0) * 4.0;

    // RGB split.
    float split = (0.5 + 2.5 * hit + 2.0 * uAudioBass) * (0.5 + tearOn);
    vec2 sp = vec2(mod(p.x + tear, res.x), p.y);
    vec3 col = vec3(fieldAt(sp + vec2(split, 0.0), fs).r, fieldAt(sp, fs).g, fieldAt(sp - vec2(split, 0.0), fs).b);


    // A category switch (and the cold-start intro) swaps the channels round while it lasts.
    if (uTransition > 0.6) col = col.brg;

    // Datamosh: some 16x16 blocks keep last frame's picture, dragged a few pixels a frame; and a
    // short afterglow everywhere.
    if (uFresh < 0.5) {
        vec2 blk = floor(p / 16.0);
        if (hash21(blk + c.s16 * 0.37) < 0.002 + 0.05 * hit) {
            vec2 mv = floor((vec2(hash21(blk + 1.3), hash21(blk + 5.1)) - 0.5) * 6.0 * (uFrameDt * 60.0));
            col = mix(col, texture(uPrev, (p + mv) / res).rgb, 0.92);
        }
        vec3 prev = texture(uPrev, p / res).rgb;
        col = max(col, prev * pow(0.5, uFrameDt / PERSIST) - 1.5 / 255.0);
    }

    // Low battery: a slow red pulse.
    if (uBatteryLevel < 0.2) col = mix(col, col * vec3(1.25, 0.35, 0.3), 0.5 + 0.5 * sin(uTime * 3.0));

    // Keep the menu's side dark, a light vignette.
    vec2 uv = (p - 0.5 * res) / res.y;
    col *= mix(MENU_DIM, 1.0, smoothstep(0.12, 0.5, p.x / res.x));
    col *= (1.0 - 0.35 * dot(uv, uv)) * 0.85;

    // Bitcrush: 7 levels a channel, Bayer-dithered in 2 px cells.
    col = floor(clamp(col, 0.0, 1.0) * LEVELS + bayer4(floor(p / 2.0))) / LEVELS;
    fragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
}
