// MEMENTO//MORI: the background shader. One pass, no feedback.
//
// A flat specimen sheet in deep blue, black and white: a diagonal split with a hatched
// cyber-border, a 1-bit dithered moon inside dashed orbits, a diagnostic grid with registration
// crosses, a tracking box with anchor handles and a coordinate readout, hex colour callouts with
// leader lines, a wireframe forget-me-not over a pentagram construction, small solid flowers,
// glass shards, ink splatter, a barcode block, a vertical spine with scrolling type, a big
// angled MEMENTO MORI in halftone stripes, scanlines and photocopy grain.
//
// The canvas decides the paper: a dark palette draws white ink on navy; a light canvas
// (the PHOTOCOPY variant) prints navy ink on white paper right of the split and leaves the menu
// side a heavy toner black with white ink, so the menu's white text stays readable.
// A category switch slices rows sideways and shifts the dither; the orbiting satellites
// and the moon's ring follow the bass of Xross's own music. Under 20% battery a LOW POWER tag
// appears under the barcode. Nothing flashes.

const float PI = 3.14159265;
const float MENU_DIM = 0.45;     // overlay strength kept over the category column
const float SPINE_SPEED = 14.0;  // spine type, font dots per second
const vec3 BLACK = vec3(0.0, 0.004, 0.016);

// @FONT generated by Memento_Mori_tools/gen_font.py, do not edit by hand
// glyph order: ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789./?!:-#*+><=@[]_%(),|~$
const int FONT[59] = int[](
    18415150, 16301615, 31491134, 16303663, 32554047, 1096767, 32039998, 18415153, 32641183, 6594844,
    18128177, 32539681, 18405233, 18667121, 15255086, 1097263, 23385646, 18136623, 16267326, 4329631,
    15255089, 4539953, 18732593, 18157905, 4329809, 32575775, 15324974, 14815428, 32553487, 16267791,
    8682793, 16268351, 15252526, 2167071, 15252014, 15235630, 4194304, 1118480, 4207119, 4198532,
    131200, 14336, 11512810, 22511061, 4357252, 2236546, 8521864, 1016800, 33554431, 14747726,
    14950670, 32505856, 27070835, 8523912, 2232450, 2228224, 4329604, 473536, 33080895);
const int STR[192] = int[](
    12, 4, 12, 4, 13, 19, 14, -1, 12, 14, 17, 8, 5, 14, 17, 6, 4, 19, -1, 12, 4, -1, 13, 14,
    19, 18, 36, 4, 36, 4, 36, 18, 36, 12, 4, 12, 4, 13, 19, 14, -1, 12, 14, 17, 8, -1, 37, 37,
    -1, 5, 14, 17, 6, 4, 19, -1, 12, 4, -1, 13, 14, 19, -1, 37, 37, -1, 19, 7, 4, -1, 7, 14,
    20, 17, -1, 1, 4, 19, 22, 4, 4, 13, -1, 3, 0, 24, 18, -1, 37, 37, -1, 18, 36, 4, 36, 4,
    36, 18, 36, -1, 37, 37, -1, 42, 26, 26, 26, 26, 5, 5, 42, 26, 26, 4, 31, 5, 5, 42, 5, 5,
    5, 5, 5, 5, 18, 15, 4, 2, 8, 12, 4, 13, -1, 26, 23, 26, 29, -1, 40, -1, 12, 24, 14, 18,
    14, 19, 8, 18, 19, 0, 17, 6, 4, 19, -1, 11, 14, 2, 10, 11, 14, 22, -1, 15, 14, 22, 4, 17,
    19, 7, 4, -1, 3, 0, 17, 10, -1, 7, 14, 20, 17, 23, 40, 24, 40, 42, 26, 26, 27, 0, 32, 32);
const int STR_OFF[14] = int[](0, 12, 25, 33, 103, 110, 117, 124, 148, 159, 168, 181, 183, 185);
const int STR_LEN[14] = int[](12, 13, 8, 70, 7, 7, 7, 24, 11, 9, 13, 2, 2, 7);
// @FONT end

// ---------------------------------------------------------------------------------------------
// Hashes, noise, dither

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

float hash21(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float vnoise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i), b = hash21(i + vec2(1.0, 0.0));
    float c = hash21(i + vec2(0.0, 1.0)), d = hash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Ordered (Bayer) dither thresholds, 0 .. 1.
float bayer2(vec2 a) { a = floor(a); return fract(dot(a, vec2(0.5, a.y * 0.75))); }
float bayer4(vec2 a) { return bayer2(0.5 * a) * 0.25 + bayer2(a); }
float bayer8(vec2 a) { return bayer4(0.5 * a) * 0.25 + bayer2(a); }

// ---------------------------------------------------------------------------------------------
// Type: the 5x5 font, 6 dots per character

float dot5(int g, int x, int y) {
    if (g < 0 || x < 0 || y < 0 || x > 4 || y > 4) return 0.0;
    return float((FONT[g] >> (y * 5 + x)) & 1);
}

// String s with its top-left at the origin of l (pixels, y down), sc pixels per dot.
float label(vec2 l, int s, float sc) {
    if (l.x < 0.0 || l.y < 0.0) return 0.0;
    ivec2 c = ivec2(floor(l / sc));
    if (c.y > 4) return 0.0;
    int ci = c.x / 6;
    if (ci >= STR_LEN[s]) return 0.0;
    return dot5(STR[STR_OFF[s] + ci], c.x - ci * 6, c.y);
}

float labelWidth(int s, float sc) { return float(STR_LEN[s] * 6 - 1) * sc; }

// String s repeated forever along x (in dots), row y.
float tickerDot(int s, float x, int y) {
    if (y < 0 || y > 4) return 0.0;
    int n = STR_LEN[s] * 6;
    int xi = int(mod(floor(x), float(n)));
    int ci = xi / 6;
    return dot5(STR[STR_OFF[s] + ci], xi - ci * 6, y);
}

// A number of nd digits, zero padded, top-left at l's origin.
float number(vec2 l, int v, int nd, float sc) {
    if (l.x < 0.0 || l.y < 0.0) return 0.0;
    ivec2 c = ivec2(floor(l / sc));
    if (c.y > 4) return 0.0;
    int ci = c.x / 6;
    if (ci >= nd) return 0.0;
    int div = 1;
    for (int k = 0; k < 6; k++) { if (k < nd - 1 - ci) div *= 10; }
    return dot5(26 + (v / div) % 10, c.x - ci * 6, c.y);   // 26: the "0" glyph
}

// ---------------------------------------------------------------------------------------------
// Line helpers (pixel units)

float lineAA(float d, float w) {
    return 1.0 - smoothstep(0.5 * w - 0.5, 0.5 * w + 0.5, abs(d));
}

float segment(vec2 p, vec2 a, vec2 b) {
    vec2 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}

mat2 rot(float a) { float c = cos(a), s = sin(a); return mat2(c, s, -s, c); }

// Distance to an axis-aligned ellipse with radii ab (first-order, good for thin lines).
float ellipseDist(vec2 p, vec2 ab) {
    float e = length(p / ab);
    float g = length(p / (ab * ab));
    return (e - 1.0) * e / max(g, 1e-4);
}

// Outline of a box (centre c, half size h), w pixels wide.
float boxLine(vec2 p, vec2 c, vec2 h, float w) {
    vec2 d = abs(p - c) - h;
    float o = length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
    return lineAA(o, w);
}

float boxFill(vec2 p, vec2 c, vec2 h) {
    vec2 d = abs(p - c) - h;
    return step(max(d.x, d.y), 0.0);
}

// Forget-me-not petal radius at angle a, five round petals.
float petalR(float a, float R) {
    return R * (0.42 + 0.58 * pow(abs(cos(2.5 * a)), 0.55));
}

// ---------------------------------------------------------------------------------------------

void main() {
    vec2 res = uResolution;
    float W = res.x, H = res.y;
    float u = H / 576.0;                              // one design unit, about 1 px on the A55
    float t = uTime;
    float tr = uTransition;
    float bass = uAudioBass;
    vec2 p = vec2(gl_FragCoord.x, H - gl_FragCoord.y);  // pixels, y down

    // A category switch slices the sheet into rows that slip sideways for a moment.
    float band = floor(p.y / (18.0 * u));
    p.x += (hash11(band + floor(t * 9.0)) - 0.5) * 70.0 * u * tr * step(0.55, hash11(band * 1.7));

    // Paper: dark canvas -> white ink on navy; light canvas -> navy ink on paper.
    float paperMode = step(0.5, dot(uColorTop.rgb, vec3(0.299, 0.587, 0.114)));
    vec3 BLUE = uAccent.rgb;   // accentSecondary: royal / cobalt
    vec3 AQUA = uGlow.rgb;     // accent: electric aqua

    // Coverage layers, composed at the end.
    float lBlue = 0.0, lBlack = 0.0, lAqua = 0.0, lInk = 0.0;

    // ---- Diagonal split ----------------------------------------------------------------------
    vec2 A = vec2(0.40 * W, H), B = vec2(0.70 * W, 0.0);
    vec2 n = normalize(vec2(A.y - B.y, B.x - A.x));   // points right
    float side = dot(p - A, n);                       // > 0 on the right
    side -= 50.0 * u * tr;
    float right = step(0.0, side);

    // Right of the split: a royal-blue halftone, denser to the right and lower down.
    float hcell = 7.0 * u;
    vec2 hp = rot(0.785) * p / hcell;
    vec2 hc = fract(hp) - 0.5;
    float tone = clamp(side / (0.55 * W), 0.0, 1.0) * 0.75 + (p.y / H) * 0.35;
    tone *= 0.55 + 0.45 * vnoise(p / (160.0 * u) + t * 0.02);
    float dotR = sqrt(clamp(tone, 0.0, 1.0)) * 0.62;
    float pp = paperMode * right;                     // this pixel is on paper (PHOTOCOPY)
    lBlue = max(lBlue, right * (1.0 - smoothstep(dotR - 0.08, dotR + 0.08, length(hc))) * (0.85 - 0.45 * paperMode));
    lBlue = max(lBlue, right * (0.42 - 0.34 * paperMode));

    // The cyber-border along the split: two hard lines and a hatched band between them.
    lInk = max(lInk, lineAA(side, 2.0 * u));
    lInk = max(lInk, lineAA(side - 22.0 * u, 1.0 * u) * 0.8);
    float inBand = step(5.0 * u, side) * step(side, 18.0 * u);
    float hatch = step(0.5, fract(dot(p, vec2(0.7071, -0.7071)) / (6.0 * u)));
    lInk = max(lInk, inBand * hatch * 0.55);

    // ---- Diagnostic grid ---------------------------------------------------------------------
    float gs = 48.0 * u;
    vec2 gq = mod(p + vec2(0.0, 12.0 * u), gs);
    vec2 gd = min(gq, gs - gq);
    float grid = max(lineAA(gd.x, 1.0), lineAA(gd.y, 1.0)) * 0.10;
    float crossMk = (step(gd.x, 5.0 * u) * lineAA(gd.y, 1.0 * u) + step(gd.y, 5.0 * u) * lineAA(gd.x, 1.0 * u));
    lInk = max(lInk, max(grid * (0.4 + 0.6 * right), min(crossMk, 1.0) * 0.45));

    // ---- The moon: 1-bit dither inside dashed orbits ------------------------------------------
    vec2 mc = vec2(0.79 * W, 0.36 * H);
    float mR = 0.27 * H;
    vec2 md = p - mc;
    float mr = length(md);
    if (mr < mR) {
        vec3 nrm = vec3(md / mR, sqrt(max(0.0, 1.0 - dot(md, md) / (mR * mR))));
        float lit = clamp(dot(nrm, normalize(vec3(-0.55, -0.45, 0.7))), 0.0, 1.0);
        float crater = vnoise(md / (26.0 * u)) * 0.55 + vnoise(md / (9.0 * u)) * 0.25;
        lit *= 1.0 - 0.45 * smoothstep(0.45, 0.8, crater);
        float th = bayer8(p / max(1.0, floor(2.0 * u)) + vec2(tr * 3.0, 0.0));
        float on = step(th, lit * 0.95);
        if (pp > 0.5) {
            lBlue = 0.0;                              // on paper: toner dots in the shadows
            lInk = max(lInk, (1.0 - on) * 0.92);
        } else {
            lBlue = max(lBlue, 0.35);
            lInk = max(lInk, on * 0.92);
            lBlack = max(lBlack, (1.0 - on) * 0.55);
        }
    }
    lInk = max(lInk, lineAA(mr - mR, 1.5 * u));
    // A dashed ring that turns, pulsing out a little with the bass.
    float ringR = mR * (1.10 + 0.03 * bass);
    float ma = atan(md.y, md.x);
    float dash = step(0.45, fract(ma * 18.0 / PI + t * 0.08));
    lAqua = max(lAqua, lineAA(mr - ringR, 1.2 * u) * dash);
    // Ticks round the outside every 10 degrees, long ones every 30.
    float tk = fract(ma * 36.0 / (2.0 * PI));
    float tl = mod(floor(ma * 36.0 / (2.0 * PI) + 36.0), 3.0) < 0.5 ? 14.0 : 7.0;
    lInk = max(lInk, step(abs(tk - 0.5), 0.06) * step(mR * 1.17, mr) * step(mr, mR * 1.17 + tl * u) * 0.7);

    // Orbits: three tilted ellipses, each with a satellite.
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float ang = -0.35 + fi * 0.62;
        vec2 ab = vec2(mR * (1.55 + 0.22 * fi), mR * (0.30 + 0.10 * fi));
        vec2 op = rot(ang) * md;
        float d = ellipseDist(op, ab);
        float oa = atan(op.y / ab.y, op.x / ab.x);
        float od = i == 1 ? step(0.5, fract(oa * 20.0 / PI)) : 1.0;
        lInk = max(lInk, lineAA(d, 1.0 * u) * 0.55 * od);
        // The satellite: a hollow square with a crosshair.
        float sp = t * (0.10 + 0.05 * fi) * (1.0 + 0.6 * bass) + fi * 2.1;
        vec2 sat = vec2(cos(sp), sin(sp)) * ab;
        vec2 sl = op - sat;
        lInk = max(lInk, boxLine(sl, vec2(0.0), vec2(4.0 * u), 1.2 * u));
        lAqua = max(lAqua, boxFill(sl, vec2(0.0), vec2(1.5 * u)));
        float chl = max(lineAA(sl.x, 1.0) * step(abs(sl.y), 11.0 * u), lineAA(sl.y, 1.0) * step(abs(sl.x), 11.0 * u));
        lInk = max(lInk, chl * step(6.0 * u, max(abs(sl.x), abs(sl.y))) * 0.8);
    }

    // ---- Hex callouts: a swatch, its code and a leader line to a marker ----------------------
    float tsc = max(1.0, floor(2.0 * u + 0.5));   // small type, pixels per dot
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        vec2 mk = mc + vec2(cos(3.5 + fi * 0.55), sin(3.5 + fi * 0.55)) * mR * 0.82;   // on the moon
        vec2 lo = i < 2 ? vec2(0.47 * W + fi * 30.0 * u, 0.205 * H + fi * 0.11 * H)    // label origin
                        : vec2(0.80 * W, 0.70 * H);
        int s = i == 0 ? 4 : (i == 1 ? 5 : 6);
        vec3 sw = i == 0 ? vec3(0.0, 0.0, 1.0) : (i == 1 ? vec3(0.0, 0.9, 1.0) : vec3(1.0));
        float lw = labelWidth(s, tsc);
        vec2 bx = vec2(lw + 22.0 * tsc / 2.0 + 10.0 * u, 7.0 * tsc + 4.0 * u);   // box size
        vec2 l = p - lo;
        float inBox = step(0.0, l.x) * step(0.0, l.y) * step(l.x, bx.x) * step(l.y, bx.y);
        if (inBox > 0.0) {
            lBlack = max(lBlack, 0.85);
            float txt = label(l - vec2(14.0 * u, 3.0 * u + tsc), s, tsc);
            lInk = max(lInk, txt);
            // The swatch: a filled square of the colour itself.
            float swa = step(4.0 * u, l.x) * step(l.x, 10.0 * u) * step(3.0 * u, l.y) * step(l.y, bx.y - 3.0 * u);
            if (swa > 0.0) { lInk = 0.0; lBlack = 0.0; lBlue = 0.0; lAqua = 0.0; }
        }
        lInk = max(lInk, boxLine(p, lo + bx * 0.5, bx * 0.5, 1.0 * u));
        // Leader: from the box's right edge, a short run then straight to the marker.
        vec2 a0 = lo + vec2(bx.x, bx.y * 0.5);
        vec2 a1 = a0 + vec2(18.0 * u, 0.0);
        float ld = min(segment(p, a0, a1), segment(p, a1, mk));
        lInk = max(lInk, lineAA(ld, 1.0 * u) * 0.85);
        float mkd = length(p - mk);
        lInk = max(lInk, lineAA(mkd - 4.0 * u, 1.2 * u));
        lInk = max(lInk, step(mkd, 1.6 * u));
        // Paint the swatch last so nothing else covers it.
        float swa2 = step(4.0 * u, l.x) * step(l.x, 10.0 * u) * step(3.0 * u, l.y) * step(l.y, bx.y - 3.0 * u);
        if (swa2 > 0.0) { fragColor = vec4(paperMode > 0.5 && i == 2 ? vec3(0.02, 0.03, 0.1) : sw, 1.0); }
        if (swa2 > 0.0) return;
    }

    // ---- The tracking box ---------------------------------------------------------------------
    {
        vec2 tc = vec2(W * (0.615 + 0.04 * (vnoise(vec2(t * 0.07, 3.0)) - 0.5) * 2.0),
                       H * (0.53 + 0.05 * (vnoise(vec2(t * 0.06, 9.0)) - 0.5) * 2.0));
        vec2 th = vec2(54.0, 66.0) * u * (1.0 + 0.06 * sin(t * 0.4));
        lInk = max(lInk, boxLine(p, tc, th, 1.0 * u) * 0.9);
        // Eight anchor handles: hollow squares at the corners and edge midpoints.
        for (int k = 0; k < 9; k++) {
            if (k == 4) continue;
            vec2 o = vec2(float(k % 3) - 1.0, float(k / 3) - 1.0);
            vec2 hcn = tc + o * th;
            lBlack = max(lBlack, boxFill(p, hcn, vec2(3.5 * u)));
            lInk = max(lInk, boxLine(p, hcn, vec2(3.5 * u), 1.2 * u));
        }
        // A crosshair at its centre with a gap.
        vec2 cl = abs(p - tc);
        float ch = max(lineAA(p.y - tc.y, 1.0) * step(cl.x, 16.0 * u), lineAA(p.x - tc.x, 1.0) * step(cl.y, 16.0 * u));
        lAqua = max(lAqua, ch * step(5.0 * u, max(cl.x, cl.y)));
        // The tab: TARGET LOCK set dark on white, on top of the box's top-left corner.
        vec2 tabO = tc - th + vec2(0.0, -9.0 * tsc / 1.0 - 4.0 * u);
        vec2 tabS = vec2(labelWidth(8, tsc) + 8.0 * u, 7.0 * tsc);
        vec2 l = p - tabO;
        if (l.x >= 0.0 && l.y >= 0.0 && l.x <= tabS.x && l.y <= tabS.y) {
            float txt = label(l - vec2(4.0 * u, tsc), 8, tsc);
            if (pp > 0.5) { lBlack = max(lBlack, 1.0 - txt); if (txt > 0.0) { lInk = 0.0; lBlue = 0.0; lBlack = 0.0; } }
            else { lInk = max(lInk, 1.0 - txt); lBlack = max(lBlack, txt); if (txt > 0.0) lInk = 0.0; }
        }
        // The readout under it: X:#### Y:####.
        vec2 ro = tc + vec2(-th.x, th.y + 6.0 * u);
        vec2 rl = p - ro;
        float rd = label(rl, 11, tsc) + number(rl - vec2(12.0 * tsc, 0.0), int(tc.x / u), 4, tsc)
                 + label(rl - vec2(42.0 * tsc, 0.0), 12, tsc) + number(rl - vec2(54.0 * tsc, 0.0), int(tc.y / u), 4, tsc);
        lInk = max(lInk, min(rd, 1.0) * 0.9);
    }

    // ---- Wireframe forget-me-not over a pentagram --------------------------------------------
    {
        vec2 fc = vec2(0.585 * W, 0.80 * H);
        float fR = 0.16 * H;
        vec2 fd = p - fc;
        float fr = length(fd);
        if (fr < fR * 1.35) {
            float spin = t * 0.05;
            vec2 fl = rot(spin) * fd;
            float fa = atan(fl.y, fl.x);
            float pr = petalR(fa, fR);
            lInk = max(lInk, lineAA(fr - pr, 1.3 * u));
            lInk = max(lInk, lineAA(fr - pr * 0.72, 1.0 * u) * 0.45);
            lInk = max(lInk, lineAA(fr - fR * 0.22, 1.2 * u));
            lAqua = max(lAqua, step(fr, fR * 0.08));
            // Construction: a dashed circle through the tips and the star joining them.
            float da = step(0.5, fract(fa * 24.0 / PI));
            lInk = max(lInk, lineAA(fr - fR, 1.0 * u) * da * 0.6);
            float star = 1e9;
            for (int k = 0; k < 5; k++) {
                float a0 = float(k) * 2.0 * PI / 5.0;
                float a1 = float(k + 2) * 2.0 * PI / 5.0;
                star = min(star, segment(fl, vec2(cos(a0), sin(a0)) * fR, vec2(cos(a1), sin(a1)) * fR));
                star = min(star, segment(fl, vec2(0.0), vec2(cos(a0), sin(a0)) * fR * 1.25));
            }
            lInk = max(lInk, lineAA(star, 1.0 * u) * 0.5);
        }
        // FORGET ME NOT, set at a slant beside it.
        vec2 fl2 = rot(-0.14) * (p - (fc + vec2(fR * 1.15, -fR * 0.55)));
        lInk = max(lInk, label(fl2, 1, tsc + 1.0));
    }

    // ---- Small solid flowers ------------------------------------------------------------------
    for (int i = 0; i < 7; i++) {
        float fi = float(i);
        vec2 c = vec2(W * (0.48 + 0.46 * hash11(fi * 3.1 + 0.4)), H * (0.10 + 0.82 * hash11(fi * 7.7 + 1.3)));
        c.y += sin(t * 0.3 + fi) * 4.0 * u;
        float r = (9.0 + 11.0 * hash11(fi * 5.3)) * u;
        vec2 d = p - c;
        float dl = length(d);
        if (dl > r * 1.1) continue;
        float a = atan(d.y, d.x) + fi + t * 0.03 * (hash11(fi) - 0.5);
        float pr = petalR(a, r);
        float petal = step(dl, pr);
        float edge = lineAA(dl - pr, 1.2 * u);
        lBlue = max(lBlue, petal);
        lBlack = max(lBlack, petal * step(pr * 0.78, dl) * 0.0);
        lAqua = max(lAqua, petal * step(dl, pr * 0.55) * step(pr * 0.40, dl) * 0.35);
        lInk = max(lInk, max(edge * 0.9, step(dl, r * 0.2)));
        lBlack = max(lBlack, step(dl, r * 0.07));
        if (petal > 0.0 && dl > r * 0.2) lInk *= 0.0 + edge;
    }

    // ---- Glass shards -------------------------------------------------------------------------
    for (int i = 0; i < 5; i++) {
        float fi = float(i);
        vec2 c = vec2(W * (0.50 + 0.42 * hash11(fi * 2.3 + 8.0)), H * (0.15 + 0.7 * hash11(fi * 4.1 + 2.0)));
        float s = (22.0 + 30.0 * hash11(fi * 9.1)) * u;
        vec2 l = rot(fi * 1.7 + 0.15 * sin(t * 0.2 + fi)) * (p - c);
        if (dot(l, l) > s * s * 2.5) continue;
        vec2 v0 = vec2(-0.8, -1.0) * s, v1 = vec2(1.0, -0.3) * s, v2 = vec2(-0.2, 1.1 + 0.4 * hash11(fi)) * s;
        float e0 = (l.x - v0.x) * (v1.y - v0.y) - (l.y - v0.y) * (v1.x - v0.x);
        float e1 = (l.x - v1.x) * (v2.y - v1.y) - (l.y - v1.y) * (v2.x - v1.x);
        float e2 = (l.x - v2.x) * (v0.y - v2.y) - (l.y - v2.y) * (v0.x - v2.x);
        bool inside = (e0 >= 0.0 && e1 >= 0.0 && e2 >= 0.0) || (e0 <= 0.0 && e1 <= 0.0 && e2 <= 0.0);
        float ed = min(segment(l, v0, v1), min(segment(l, v1, v2), segment(l, v2, v0)));
        if (inside) {
            lBlack = max(lBlack, 0.35);
            lAqua = max(lAqua, 0.10 + 0.25 * step(0.82, fract((l.x + l.y) / (11.0 * u))));
        }
        lInk = max(lInk, lineAA(ed, 1.2 * u) * 0.95);
    }

    // ---- Ink splatter -------------------------------------------------------------------------
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        vec2 c = vec2(W * (0.47 + 0.42 * hash11(fi * 6.6 + 3.0)), H * (0.2 + 0.6 * hash11(fi * 1.9 + 5.0)));
        vec2 d = (p - c) / u;
        float r = length(d);
        if (r > 90.0) continue;
        float blob = vnoise(d / 11.0 + fi * 13.0) * 0.6 + vnoise(d / 4.0 + fi * 7.0) * 0.4;
        float splat = step(r / 38.0, blob * 1.1 - 0.2);
        float drops = step(0.92, hash21(floor(d / 3.0) + fi * 31.0)) * step(r, 80.0) * step(28.0, r) * step(vnoise(d / 6.0), 0.35);
        lBlack = max(lBlack, max(splat, drops));
        if (splat + drops > 0.0) { lInk *= 0.2; lBlue *= 0.3; }
    }

    // ---- Big angled MEMENTO MORI, filled with scan stripes ------------------------------------
    {
        float bs = max(2.0, floor(8.0 * u));
        vec2 bo = vec2(0.27 * W, 0.885 * H - 5.0 * bs);
        vec2 l = p - bo;
        l.x += (l.y - 5.0 * bs) * 0.28;              // lean the letters right
        float big = label(l, 0, bs);
        float stripes = step(0.45, fract(p.y / (3.0 * u)));
        float drop = big > 0.0 ? step(0.28, vnoise(p / (5.0 * u))) : 0.0;   // photocopy dropout
        lBlue = max(lBlue, big * 0.95);
        lInk = max(lInk, big * stripes * drop * 0.55);
        // A thin outline offset up-left, misregistered.
        vec2 lo = l + vec2(3.0 * u, 3.0 * u);
        float bo2 = label(lo, 0, bs);
        lAqua = max(lAqua, bo2 * (1.0 - big) * 0.9);
    }

    // ---- Header, the dark hour tag, S.E.E.S. and the barcode ---------------------------------
    {
        vec2 ho = vec2(0.42 * W, 46.0 * u);
        lInk = max(lInk, label(p - ho, 7, tsc) * 0.85);
        lInk = max(lInk, lineAA(p.y - (ho.y + 8.0 * tsc), 1.0) * step(ho.x, p.x) * step(p.x, W - 60.0 * u) * 0.6);
        // Tick ruler along that rule.
        float tkx = mod(p.x - ho.x, 8.0 * u);
        lInk = max(lInk, step(tkx, 1.0 * u) * step(ho.y + 8.0 * tsc, p.y) * step(p.y, ho.y + 8.0 * tsc + 4.0 * u)
                         * step(ho.x, p.x) * step(p.x, W - 60.0 * u) * 0.5);

        vec2 dh = vec2(0.42 * W, ho.y + 8.0 * tsc + 10.0 * u);
        lAqua = max(lAqua, label(p - dh, 10, tsc));

        // Barcode block, bottom right.
        vec2 bo = vec2(W - 300.0 * u, H - 70.0 * u);
        vec2 bs = vec2(220.0 * u, 34.0 * u);
        vec2 l = p - bo;
        if (l.x >= 0.0 && l.y >= 0.0 && l.x < bs.x && l.y < bs.y + 14.0 * u) {
            float col = floor(l.x / max(1.0, floor(1.5 * u)));
            float bar = step(0.48, hash11(col * 0.37 + floor(col / 7.0)));
            if (l.y < bs.y) lInk = max(lInk, bar);
            else lInk = max(lInk, number(l - vec2(4.0 * u, bs.y + 4.0 * u), 451200 + int(mod(floor(t * 0.5), 99.0)), 6, tsc) * 0.9);
        }
        lInk = max(lInk, label(p - (bo + vec2(0.0, -10.0 * tsc / 1.0)), 2, tsc + 1.0));
        lAqua = max(lAqua, label(p - (bo + vec2(labelWidth(2, tsc + 1.0) + 10.0 * u, -10.0 * tsc)), 13, tsc));
        if (uBatteryLevel < 0.2) {
            vec2 lp = p - (bo + vec2(0.0, bs.y + 18.0 * u));
            vec2 ls = vec2(labelWidth(9, tsc) + 8.0 * u, 7.0 * tsc);
            if (lp.x >= 0.0 && lp.y >= 0.0 && lp.x <= ls.x && lp.y <= ls.y) {
                float txt = label(lp - vec2(4.0 * u, tsc), 9, tsc);
                lAqua = max(lAqua, 1.0 - txt);
                lBlack = max(lBlack, txt * (1.0 - pp));
                if (pp > 0.5 && txt > 0.0) { lAqua = 0.0; lInk = 0.0; lBlue = 0.0; }
            }
        }
    }

    // ---- The spine: a white bar with type running up it, and a ruler ------------------------
    {
        float sx = W - 38.0 * u, sw = 7.0 * tsc + 6.0 * u;
        float lx = p.x - sx;
        if (lx >= 0.0 && lx < sw) {
            float along = (H - p.y) / tsc + t * SPINE_SPEED;
            int acr = int(floor((lx - 3.0 * u) / tsc)) - 1;
            float txt = tickerDot(3, along, 4 - acr);
            if (pp > 0.5) {                           // on paper: a black bar, the type left as paper
                lBlack = max(lBlack, 1.0 - txt);
                if (txt > 0.0) { lInk = 0.0; lAqua = 0.0; lBlue = 0.0; lBlack = 0.0; }
            } else {
                lInk = max(lInk, 1.0 - txt);
                lBlack = max(lBlack, txt);
                if (txt > 0.0) { lInk = 0.0; lAqua = 0.0; }
            }
        }
        float rx = sx - 10.0 * u;
        lInk = max(lInk, lineAA(p.x - rx, 1.0) * 0.7);
        float rk = mod(p.y, 12.0 * u);
        float rlen = mod(floor(p.y / (12.0 * u)), 5.0) < 0.5 ? 9.0 : 4.0;
        lInk = max(lInk, step(rk, 1.0 * u) * step(rx - rlen * u, p.x) * step(p.x, rx) * 0.7);
        // A thin left spine for the menu side, very faint.
        float lsx = 22.0 * u;
        lInk = max(lInk, lineAA(p.x - lsx, 1.0) * 0.25);
        lInk = max(lInk, step(mod(p.y, 24.0 * u), 1.0 * u) * step(lsx - 4.0 * u, p.x) * step(p.x, lsx) * 0.25);
    }

    // ---- Corner brackets: cyber-borders on the sheet ------------------------------------------
    {
        vec2 m = vec2(14.0 * u);
        float arm = 40.0 * u;
        vec2 cd = res * 0.5 - abs(p - res * 0.5) - m;     // distance in from the nearest edges
        float corner = step(cd.x, arm) * step(cd.y, arm);
        float edge = max(lineAA(cd.x, 2.0 * u) * step(0.0, cd.y), lineAA(cd.y, 2.0 * u) * step(0.0, cd.x));
        lInk = max(lInk, edge * corner * 0.9);
    }

    // ---- Compose ------------------------------------------------------------------------------
    float vy = gl_FragCoord.y / H;
    vec3 bg = mix(paperMode > 0.5 ? uColorTop.rgb * 0.9 : uColorBottom.rgb, uColorTop.rgb, vy);
    // Analog paper noise: blotchy, then fine grain.
    float paper = vnoise(p / (3.0 * u)) * 0.5 + vnoise(p / (40.0 * u)) * 0.5;
    bg *= 0.86 + 0.22 * paper;
    // Ink: white everywhere on a dark canvas; on paper, navy right of the split and white on the
    // toner-black menu side.
    float onPaper = pp;
    vec3 INK = mix(vec3(0.96, 0.975, 1.0), vec3(0.02, 0.03, 0.10), onPaper);
    if (onPaper > 0.5) AQUA = BLUE;
    if (paperMode > 0.5) {
        bg = mix(bg, bg * vec3(0.90, 0.92, 0.97), smoothstep(0.55, 0.9, paper));
        vec3 toner = vec3(0.012, 0.016, 0.04) * (0.7 + 0.6 * paper);
        bg = mix(toner, bg, right);
    }

    // Keep the category column quiet.
    float menu = mix(MENU_DIM, 1.0, smoothstep(0.18 * W, 0.40 * W, p.x));
    lBlue *= menu; lAqua *= menu; lInk *= menu; lBlack *= menu;

    vec3 col = bg;
    col = mix(col, BLUE * (paperMode > 0.5 ? 1.0 : 0.85), clamp(lBlue, 0.0, 1.0));
    col = mix(col, BLACK, clamp(lBlack, 0.0, 1.0));
    col = mix(col, AQUA, clamp(lAqua, 0.0, 1.0));
    col = mix(col, INK, clamp(lInk, 0.0, 1.0));

    // Scanlines, a vignette and grain; a cold-start reveal from the top.
    float scan = mod(gl_FragCoord.y, max(2.0, floor(3.0 * u)));
    col *= scan < 1.0 ? (paperMode > 0.5 ? 0.94 : 0.80) : 1.0;
    vec2 vq = gl_FragCoord.xy / res - 0.5;
    col *= 1.0 - 0.45 * dot(vq, vq) * (1.0 - paperMode * 0.6);
    col += (hash21(gl_FragCoord.xy + fract(t * 7.0) * 91.0) - 0.5) * 0.045;
    col += (hash21(gl_FragCoord.xy + fract(t)) - 0.5) / 255.0;
    fragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
}
