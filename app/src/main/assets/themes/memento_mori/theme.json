{
  "schemaVersion": 2,
  "name": "MEMENTO//MORI",
  "author": "Beluwhal",
  "version": "1.0",
  "description": "A deconstructed album cover in royal blue, navy, black and white: a melancholic student cut out of a cobalt slab, forget-me-nots, glass shards and specimen boxes with anchor handles over a live specimen sheet (a dithered moon in dashed orbits, a diagonal split, a tracking box, hex callouts, a barcode, a scrolling spine and a big angled MEMENTO MORI). Distressed serif type, a photocopy UI filter, glass-and-Rhodes UI sounds and two loops: a 170 BPM breakcore piece and a slow piano for the dark hour. Variants: THE DARK HOUR, PHOTOCOPY, COBALT SIGNAL and QUIET. Original work, inspired by the Persona 3 era of 2000s anime UI, cyber-grunge and breakcore; no game assets are used.",
  "imports": [
    "surfaces.json",
    "rules.json"
  ],
  "palette": {
    "canvas": "#030A2E",
    "accent": "#3FE6FF",
    "accentSecondary": "#1B3BFF",
    "focusGold": "#CFE0FF",
    "textPrimary": "#F4F8FF",
    "textSecondary": "#8EA4E8",
    "circadianCurve": false,
    "batteryTint": false
  },
  "wave": {
    "speed": 1.0,
    "lineCount": 3,
    "turbulence": 0.7,
    "ribbonThickness": 0.9,
    "gradient": [
      "#030A2E",
      "#000105"
    ]
  },
  "typography": {
    "display": "fonts/Arsenal-Bold.ttf",
    "body": "fonts/Arsenal-Regular.ttf",
    "mono": "fonts/Redaction50-Regular.ttf"
  },
  "audio": {
    "bgmFile": "none"
  },
  "effects": {
    "shaderPath": "dark_hour.frag",
    "wallpaperPath": "wallpapers/specimen.png",
    "surfaceStyle": "specimen_frame",
    "adaptiveGamePalette": false,
    "focusFrameStyle": "HARD_SHADOW",
    "iconMask": "NONE",
    "iconFilter": "DUOTONE",
    "foregroundParticles": "DUST_MOTES",
    "backgroundFilter": "NONE",
    "bootIntro": "SHADER",
    "launchCurtain": "FLASH"
