    "unfocusedAlpha": 0.4,
    "uiScale": 1.0,
    "focusDivider": "FULL_BLEED_LINE",
    "drillDownStyle": "BREADCRUMB",
    "textOverflow": "EDGE_FADE",
    "motionProfile": "SNAPPY"
