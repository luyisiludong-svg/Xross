// UNIT//TERMINAL, INTRUSION mode UI filter (Android 13+): a monochrome monitor.
//   * every colour goes to grey, a touch cool
//   * interlace: every other 1 dp row a little darker
//   * a faint bright band rolling down the screen every 10 s
//   * every 12 s, with a 25% chance, a 0.1 s nudge: a few 4 dp rows slide up to 2 dp sideways
// Nothing flashes or inverts.
// Xross sets every uniform declared here, and only those; all four are used.
uniform shader content;
uniform float2 uResolution;
uniform float uTime;
uniform float uPxPerDp;

float hash(float n) {
    return fract(sin(n * 12.9898) * 43758.5453);
}

half4 main(float2 p) {
    float slot = floor(uTime / 12.0);
    float glitch = step(uTime - slot * 12.0, 0.1) * step(0.75, hash(slot * 1.3 + 0.7));
    float shift = 0.0;
    if (glitch > 0.0) {
        float band = floor(p.y / (4.0 * uPxPerDp));
        shift = step(0.85, hash(band * 11.7 + slot * 5.1)) * (hash(band + slot * 2.3) - 0.5) * 4.0 * uPxPerDp;
    }
    half4 c = content.eval(p + float2(shift, 0.0));

    half lum = dot(c.rgb, half3(0.299, 0.587, 0.114));    // premultiplied, so lum <= alpha
    half3 rgb = lum * half3(0.96, 0.98, 1.0);

    half lines = mod(floor(p.y / uPxPerDp), 2.0) < 1.0 ? 1.0 : 0.9;
    float barY = fract(uTime / 10.0) * uResolution.y;
    half bar = half(exp(-abs(p.y - barY) / (14.0 * uPxPerDp)) * 0.06);
    rgb = min(rgb * lines + bar * c.a, half3(c.a));
    return half4(rgb, c.a);
}
