// UNIT//TERMINAL, INTRUSION mode: a monochrome network space for Xross.
//
// Black void and white hairlines:
//   a perspective grid floor that streams toward the horizon, with a faint mirrored ceiling,
//   a core on the right made of nested squares turning against each other, ringed by a
//   dashed orbit, pulsing with the music,
//   five floating nodes (hollow squares with a lit centre) drifting at different depths,
//   data packets: short bright dashes running along rows toward the core,
//   a header, an ACCESS counter that fills and resets, and a ticker along the bottom.
// A category switch (and the cold-start SHADER intro) slips rows sideways and flickers blocks
// of static for a moment; nothing flashes or inverts.
//
// One pass, no feedback.
//
// Uniforms used: uTime, uResolution, uColorTop / uColorBottom (the void), uAccent (grid and
// text), uGlow (the core, nodes and packets), uBatteryLevel (a WARNING line and a red core
// under 20%), uAudioBass (the core pulses), uAudioBeat (packets brighten), uTransition.

const float GLITCH = 0.5;      // strength of the category-switch glitch (1 = the original)
const float PI = 3.14159265;
const vec3 ALERT = vec3(0.86, 0.30, 0.24);
const float MENU_DIM = 0.5;

// @FONT generated by Unit_Terminal_tools/gen_font.py, do not edit by hand
// glyph order: ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789./?!:-#*+><=@[]_%(),|~$
const int FONT[59] = int[](
    18415150, 16301615, 31491134, 16303663, 32554047, 1096767, 32039998, 18415153, 32641183, 6594844,
    18128177, 32539681, 18405233, 18667121, 15255086, 1097263, 23385646, 18136623, 16267326, 4329631,
    15255089, 4539953, 18732593, 18157905, 4329809, 32575775, 15324974, 14815428, 32553487, 16267791,
    8682793, 16268351, 15252526, 2167071, 15252014, 15235630, 4194304, 1118480, 4207119, 4198532,
    131200, 14336, 11512810, 22511061, 4357252, 2236546, 8521864, 1016800, 33554431, 14747726,
    14950670, 32505856, 27070835, 8523912, 2232450, 2228224, 4329604, 473536, 33080895);
const int STR[120] = int[](
    8, 13, 19, 17, 20, 18, 8, 14, 13, -1, 37, 37, -1, 13, 14, 3, 4, -1, 26, 23, 29, 5, 1, 24,
    15, 0, 18, 18, -1, 5, 8, 17, 4, 22, 0, 11, 11, -1, 40, 40, -1, 8, 13, 9, 4, 2, 19, -1,
    15, 17, 14, 19, 14, 2, 14, 11, -1, 40, 40, -1, 19, 17, 0, 2, 4, -1, 17, 14, 20, 19, 4, -1,
    40, 40, -1, 3, 4, 2, 17, 24, 15, 19, -1, 2, 14, 17, 4, -1, 40, 40, -1, 2, 14, 17, 4, 22,
    0, 17, 13, 8, 13, 6, -1, 40, -1, 11, 14, 22, -1, 15, 14, 22, 4, 17, 0, 2, 2, 4, 18, 18);
const int STR_OFF[5] = int[](0, 22, 91, 95, 114);
const int STR_LEN[5] = int[](22, 69, 4, 19, 6);
// @FONT end

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

float hash21(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float dot5(int g, int x, int y) {
    if (g < 0 || x < 0 || y < 0 || x > 4 || y > 4) return 0.0;
    return float((FONT[g] >> (y * 5 + x)) & 1);
}

float textDot(int s, int x, int y) {
    if (x < 0 || y < 0 || y > 4) return 0.0;
    int ci = x / 6;
    if (ci >= STR_LEN[s]) return 0.0;
    return dot5(STR[STR_OFF[s] + ci], x - ci * 6, y);
}

float tickerDot(int s, float x, int y) {
    if (y < 0 || y > 4) return 0.0;
    int n = STR_LEN[s] * 6;
    int xi = int(mod(floor(x), float(n)));
    int ci = xi / 6;
    return dot5(STR[STR_OFF[s] + ci], xi - ci * 6, y);
}

float label(ivec2 q, int s, ivec2 o, int sc) {
    ivec2 l = q - o;
    if (l.x < 0 || l.y < 0) return 0.0;
    return textDot(s, l.x / sc, l.y / sc);
}

float lineAA(float d, float w) {
    return 1.0 - smoothstep(0.5 * w - 0.5, 0.5 * w + 0.5, abs(d));
}

// Outline of a square of half-size h turned by angle a, w pixels wide, at offset d.
float squareOutline(vec2 d, float h, float a, float w) {
    float c = cos(a), s = sin(a);
    vec2 r = abs(mat2(c, -s, s, c) * d);
    return lineAA(max(r.x, r.y) - h, w);
}

// A perspective grid on a plane: y is the distance from the horizon in uv (> 0).
float grid(vec2 uv, float y, float scroll) {
    float z = 0.16 / y;
    vec2 f = vec2(uv.x * z * 2.4, z + scroll);
    vec2 w = fwidth(f);
    vec2 gl = abs(fract(f) - 0.5);
    float l = max(1.0 - smoothstep(0.5 - w.x * 1.2, 0.5, gl.x), 1.0 - smoothstep(0.5 - w.y * 1.2, 0.5, gl.y));
    return l * smoothstep(0.0, 0.16, y);   // fade into the horizon
}

void main() {
    vec2 res = uResolution;
    float t = uTime;
    float tr = GLITCH * clamp(uTransition, 0.0, 1.0);   // the category-switch glitch, scaled
    float sc = max(1.0, floor(min(res.x, res.y) / 288.0));
    int isc = int(sc);
    bool low = uBatteryLevel < 0.2;

    vec2 px = gl_FragCoord.xy;
    if (tr > 0.01) {
        float row = floor(px.y / (4.0 * sc));
        float tick = floor(t * 20.0);
        float on = step(1.0 - 0.33 * tr, hash11(row * 5.31 + tick * 0.77));
        px.x += floor((hash11(row * 2.9 + tick) - 0.5) * 42.0 * tr) * sc * on;
    }
    ivec2 q = ivec2(floor(vec2(px.x, res.y - px.y)));
    vec2 uv = (px - 0.5 * res) / res.y;
    float aspect = res.x / res.y;

    vec3 INK = uAccent.rgb;
    vec3 HI = low ? ALERT : uGlow.rgb;
    vec3 col = mix(uColorBottom.rgb, uColorTop.rgb, smoothstep(-0.5, 0.5, uv.y));

    // Floor and a fainter ceiling.
    float hz = -0.06;
    float scroll = t * 0.35;
    if (uv.y < hz) col = mix(col, INK, grid(uv, hz - uv.y, scroll) * 0.30);
    else if (uv.y > 0.30) col = mix(col, INK, grid(uv, uv.y - 0.30 + 0.02, -scroll * 0.5) * 0.08);
    col = mix(col, HI, lineAA((uv.y - hz) * res.y, 1.0) * 0.5);
    col += HI * 0.05 * exp(-abs(uv.y - hz) * 18.0);

    // The core.
    vec2 cc = aspect >= 1.0 ? vec2(max(0.5 * aspect - 0.42, 0.06), 0.06) : vec2(0.05, 0.12);
    vec2 d = (uv - cc) * res.y;
    float R = (aspect >= 1.0 ? 0.13 * res.y : 0.18 * res.x) * (1.0 + 0.05 * uAudioBass);
    {
        float r = length(d);
        float core = 0.0;
        for (int i = 0; i < 4; i++) {
            float fi = float(i);
            float h = R * (1.0 - 0.22 * fi);
            float a = t * (0.22 + 0.13 * fi) * (mod(fi, 2.0) < 1.0 ? 1.0 : -1.0) + fi * 0.4;
            core = max(core, squareOutline(d, h, a, i == 0 ? 2.0 : 1.2) * (1.0 - 0.15 * fi));
        }
        vec2 ad = abs(d);
        core = max(core, step(max(ad.x, ad.y), R * 0.12 * (1.0 + 0.4 * uAudioBass)));
        float u = atan(d.y, d.x) / (2.0 * PI) + 0.5;
        float orbit = lineAA(r - R * 1.6, 1.0) * step(0.45, fract(u * 48.0 + t * 0.3));
        col = mix(col, INK, orbit * 0.45);
        col = mix(col, HI, core * 0.85);
        col += HI * 0.10 * exp(-r / (R * 0.9));
        ivec2 lo = ivec2(floor(cc * res.y + 0.5 * res));
        lo = ivec2(lo.x - 11 * isc, int(res.y) - lo.y + int(R * 1.6) + 10 * isc);
        col = mix(col, INK, label(q, 2, lo, isc) * 0.6);
    }

    // Floating nodes at different depths.
    for (int i = 0; i < 5; i++) {
        float fi = float(i);
        vec2 base = vec2(mix(0.0, 0.5 * aspect - 0.06, hash11(fi * 3.7 + 1.0)), mix(-0.30, 0.36, hash11(fi * 9.1 + 2.0)));
        base += 0.03 * vec2(sin(t * 0.21 + fi * 1.7), cos(t * 0.17 + fi * 2.3));
        float depth = 0.5 + hash11(fi * 5.3);
        float h = 9.0 * sc * depth;
        vec2 nd = (uv - base) * res.y;
        float n = squareOutline(nd, h, t * 0.1 * (fi - 2.0), 1.2);
        vec2 an = abs(nd);
        n = max(n, step(max(an.x, an.y), h * 0.3));
        col = mix(col, HI, n * 0.25 * depth);
    }

    // Data packets running toward the core along rows.
    {
        float lane = floor(px.y / (12.0 * sc));
        float hl = hash11(lane * 1.93);
        if (hl > 0.72) {
            float speed = (60.0 + 90.0 * hash11(lane * 4.1)) * sc;
            float len = (10.0 + 24.0 * hash11(lane * 7.7)) * sc;
            float period = res.x * 1.3;
            float x = mod(px.x - t * speed + hl * period, period);
            float body = step(x, len) * lineAA(mod(px.y, 12.0 * sc) - 6.0 * sc, sc);
            float head = smoothstep(0.0, len, x);
            col = mix(col, HI, body * head * (0.35 + 0.35 * uAudioBeat));
        }
    }

    // Header, the ACCESS counter and the ticker.
    {
        int x0 = int(res.x * 0.36);
        int yTop = 30 * isc, yBot = int(res.y) - 26 * isc;
        if (q.x >= x0 && (q.y == yTop || q.y == yBot)) col = mix(col, INK, 0.35);
        col = mix(col, INK, label(q, 0, ivec2(x0 + 30 * isc, yTop + 10 * isc), isc) * 0.6);
        float blink = low ? 0.55 + 0.45 * sin(t * 2.0) : 1.0;
        if (low) col = mix(col, ALERT, label(q, 3, ivec2(x0 + 30 * isc, yTop + 19 * isc), isc) * 0.6 * blink);

        // ACCESS 000% .. 100%, filling over 20 s, with a bar under it; top right (the bottom right
        // corner is where Xross puts its button hints).
        ivec2 ao = ivec2(int(res.x) - (11 * 6 - 1) * isc - 18 * isc, yTop + 10 * isc);
        ivec2 l = q - ao;
        int pct = int(min(fract(t / 20.0) * 1.2, 1.0) * 100.0);
        if (l.x >= 0 && l.y >= 0 && l.y < 5 * isc && l.x < 11 * 6 * isc) {
            ivec2 dl = l / isc;
            int ci = dl.x / 6;
            int g = -1;
            if (ci < 6) g = STR[STR_OFF[4] + ci];
            else if (ci == 7) g = 26 + pct / 100;
            else if (ci == 8) g = 26 + (pct / 10) % 10;
            else if (ci == 9) g = 26 + pct % 10;
            else if (ci == 10) g = 52;
            col = mix(col, ci < 6 ? INK : HI, dot5(g, dl.x - ci * 6, dl.y) * 0.7);
        }
        ivec2 bl = q - (ao + ivec2(0, 8 * isc));
        if (bl.x >= 0 && bl.x < 46 * isc && bl.y >= 0 && bl.y < 2 * isc) {
            float filled = step(float(bl.x), float(pct) * 0.46 * sc);
            col = mix(col, filled > 0.0 ? HI : INK, filled > 0.0 ? 0.65 : 0.15);
        }

        int ty = yBot + 9 * isc;
        if (q.x >= x0 && q.y >= ty && q.y < ty + 5 * isc) {
            float x = float(q.x - x0) / sc + t * 11.0;
            float edge = smoothstep(0.0, 40.0 * sc, float(q.x - x0)) * smoothstep(0.0, 40.0 * sc, res.x - float(q.x));
            col = mix(col, INK, tickerDot(1, x, (q.y - ty) / isc) * 0.4 * edge);
        }
    }

    // The rebuild: blocks of static for a moment.
    if (tr > 0.01) {
        vec2 id = floor(px / (10.0 * sc));
        float on = step(hash21(id + floor(t * 16.0) * 0.53), tr * 0.17);
        float st = hash21(floor(px / sc) + floor(t * 30.0));
        col = mix(col, INK * st, on * 0.35);
    }

    // Interlace: every other font-dot row a little darker.
    col *= (int(floor(px.y / sc)) % 2 == 0) ? 1.0 : 0.88;

    if (low) col = mix(col, col * vec3(1.2, 0.7, 0.65), 0.5);
    col *= mix(MENU_DIM, 1.0, smoothstep(0.06, 0.42, gl_FragCoord.x / res.x));
    col *= 1.0 - 0.35 * dot(uv, uv);
    col += (hash21(gl_FragCoord.xy + fract(t)) - 0.5) / 255.0;
    fragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
}
