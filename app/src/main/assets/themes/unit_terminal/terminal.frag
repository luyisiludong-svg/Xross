// UNIT//TERMINAL: an android field-terminal background for Xross.
//
// A sepia operations screen, drawn in thin parchment lines over umber paper:
//   paper grain and a dot grid with registration crosses,
//   a frame of hairline rules with a tick ruler, a hatched band, a header and a status line,
//   a scanner on the right: three rings (a ticked dial, rotating segmented arcs, a dashed ring),
//   orbiting square markers, a crosshair and a rotating diamond core, labelled with a live
//   SYNC readout,
//   small hollow and filled squares rising slowly, like data leaving the screen,
//   a data column at the right edge, a slow scan sweep, and a ticker crawling along the bottom.
// A category switch (and the cold-start SHADER intro) rebuilds the screen: rows slip sideways
// and blocks of the picture are redrawn as outlines for a moment. Nothing flashes.
//
// One pass, no feedback. Every element is a few comparisons per pixel; text is drawn only
// inside its own box.
//
// Uniforms used: uTime, uResolution, uColorTop / uColorBottom (the paper), uAccent (line ink:
// grid, rules, squares, text), uGlow (highlights: the scanner's arcs and core, the sweep),
// uBatteryLevel (a WARNING line and a red scanner under 20%), uAudioBass (the scanner breathes),
// uAudioBeat (the dial's ticks catch the beat), uTransition (the rebuild).

const float GLITCH = 0.5;      // strength of the category-switch glitch (1 = the original)
const float PI = 3.14159265;
const vec3 ALERT = vec3(0.80, 0.36, 0.27);   // low-battery red
const float MENU_DIM = 0.55;                  // brightness kept behind the category column
const float SWEEP_PERIOD = 11.0;              // seconds per scan sweep
const float TICKER_SPEED = 9.0;               // ticker crawl, in font dots per second

// @FONT generated by Unit_Terminal_tools/gen_font.py, do not edit by hand
// glyph order: ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789./?!:-#*+><=@[]_%(),|~$
const int FONT[59] = int[](
    18415150, 16301615, 31491134, 16303663, 32554047, 1096767, 32039998, 18415153, 32641183, 6594844,
    18128177, 32539681, 18405233, 18667121, 15255086, 1097263, 23385646, 18136623, 16267326, 4329631,
    15255089, 4539953, 18732593, 18157905, 4329809, 32575775, 15324974, 14815428, 32553487, 16267791,
    8682793, 16268351, 15252526, 2167071, 15252014, 15235630, 4194304, 1118480, 4207119, 4198532,
    131200, 14336, 11512810, 22511061, 4357252, 2236546, 8521864, 1016800, 33554431, 14747726,
    14950670, 32505856, 27070835, 8523912, 2232450, 2228224, 4329604, 473536, 33080895);
const int STR[224] = int[](
    14, 15, 4, 17, 0, 19, 14, 17, -1, 11, 8, 13, 10, -1, 37, 37, -1, 18, 24, 18, 36, 14, 18, -1,
    21, 27, 36, 26, 26, 11, 8, 13, 10, -1, 4, 18, 19, 0, 1, 11, 8, 18, 7, 4, 3, -1, 40, 40,
    -1, 1, 11, 0, 2, 10, -1, 1, 14, 23, -1, 18, 8, 6, 13, 0, 11, -1, 18, 19, 0, 1, 11, 4,
    -1, 40, 40, -1, 0, 11, 11, -1, 20, 13, 8, 19, 18, -1, 18, 19, 0, 13, 3, 8, 13, 6, -1, 1,
    24, -1, 40, 40, -1, 12, 4, 12, 14, 17, 24, -1, 0, 17, 2, 7, 8, 21, 4, -1, 18, 24, 13, 2,
    7, 17, 14, 13, 8, 18, 4, 3, -1, 40, 40, -1, 14, 17, 1, 8, 19, 0, 11, -1, 17, 4, 11, 0,
    24, -1, 14, 13, 11, 8, 13, 4, -1, 40, 40, -1, 18, 19, 0, 19, 20, 18, -1, 40, -1, 14, 13, 11,
    8, 13, 4, 22, 0, 17, 13, 8, 13, 6, -1, 40, -1, 11, 14, 22, -1, 15, 14, 22, 4, 17, 18, 4,
    2, 19, 14, 17, -1, 27, 27, -1, 57, -1, 18, 2, 0, 13, 18, 24, 13, 2, 49, -1, 0, 17, 2, 7,
    8, 21, 4, -1, 50, 11, 14, 6);
const int STR_OFF[8] = int[](0, 29, 156, 171, 190, 206, 210, 221);
const int STR_LEN[8] = int[](29, 127, 15, 19, 16, 4, 11, 3);
// @FONT end

// ---------------------------------------------------------------------------------------------
// Hashes, noise and helpers

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

float hash21(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float vnoise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i), b = hash21(i + vec2(1.0, 0.0));
    float c = hash21(i + vec2(0.0, 1.0)), d = hash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Glyph g's dot at (x, y), y down from the top; 0 outside its 5x5 box or for a space (-1).
float dot5(int g, int x, int y) {
    if (g < 0 || x < 0 || y < 0 || x > 4 || y > 4) return 0.0;
    return float((FONT[g] >> (y * 5 + x)) & 1);
}

// String s set once from (0, 0), 6 cells per character.
float textDot(int s, int x, int y) {
    if (x < 0 || y < 0 || y > 4) return 0.0;
    int ci = x / 6;
    if (ci >= STR_LEN[s]) return 0.0;
    return dot5(STR[STR_OFF[s] + ci], x - ci * 6, y);
}

// String s repeated forever along x.
float tickerDot(int s, float x, int y) {
    if (y < 0 || y > 4) return 0.0;
    int n = STR_LEN[s] * 6;
    int xi = int(mod(floor(x), float(n)));
    int ci = xi / 6;
    return dot5(STR[STR_OFF[s] + ci], xi - ci * 6, y);
}

// String s with its top-left at o (pixels, y down), sc pixels per dot.
float label(ivec2 q, int s, ivec2 o, int sc) {
    ivec2 l = q - o;
    if (l.x < 0 || l.y < 0) return 0.0;
    return textDot(s, l.x / sc, l.y / sc);
}

// Width in pixels of string s at sc pixels per dot (the last character's gap left out).
int labelWidth(int s, int sc) {
    return (STR_LEN[s] * 6 - 1) * sc;
}

// A line of width w (pixels) at distance d (pixels), with a one-pixel soft edge.
float lineAA(float d, float w) {
    return 1.0 - smoothstep(0.5 * w - 0.5, 0.5 * w + 0.5, abs(d));
}

// ---------------------------------------------------------------------------------------------
// The scanner on the right. d: offset from its centre in pixels; R: outer radius in pixels.
// Returns (ink, highlight) coverage.

vec2 scanner(vec2 d, float R, float t, float sc) {
    float r = length(d);
    if (r > R * 1.25) {
        // Only the crosshair reaches out here.
        float ch = max(lineAA(d.y, 1.0) * step(abs(d.x), R * 1.6), lineAA(d.x, 1.0) * step(abs(d.y), R * 1.35));
        float dash = step(0.5, fract((abs(d.x) + abs(d.y)) / (6.0 * sc)));
        return vec2(ch * dash * 0.35, 0.0);
    }
    float a = atan(d.y, d.x);              // -pi .. pi
    float u = a / (2.0 * PI) + 0.5;        // 0 .. 1 round
    float ink = 0.0, hi = 0.0;

    // Dial: a hairline with 120 ticks inside, every tenth longer; the ruler turns very slowly.
    ink = max(ink, lineAA(r - R, 1.0));
    float tu = fract(u * 120.0 + t * 0.05);
    float tick = step(tu, 0.16) * step(R - (fract(u * 12.0 + t * 0.05 / 10.0) < 0.016 ? 9.0 : 4.0) * sc, r) * step(r, R);
    ink = max(ink, tick * (0.8 + 0.6 * uAudioBeat));

    // Segmented arcs, 3 px thick, five segments with uneven gaps, turning one way.
    float R2 = R * 0.74;
    float su = fract(u + t * 0.012);
    float seg = step(0.12, fract(su * 5.0)) * step(fract(su * 5.0), 0.12 + 0.55 + 0.25 * hash11(floor(su * 5.0)));
    hi = max(hi, lineAA(r - R2, 3.0 * sc * 0.5 + 1.0) * seg);
    ink = max(ink, lineAA(r - R2 - 5.0 * sc, 1.0) * 0.5);

    // A dashed ring turning the other way.
    float R3 = R * 0.46;
    float du = fract(u * 36.0 - t * 0.6);
    ink = max(ink, lineAA(r - R3, 1.5) * step(du, 0.55));

    // The core: a small circle and a turning diamond.
    float R4 = R * 0.14;
    ink = max(ink, lineAA(r - R4, 1.0) * 0.7);
    float ca = cos(t * 0.35), sa = sin(t * 0.35);
    vec2 dr = mat2(ca, -sa, sa, ca) * d;
    float dia = abs(dr.x) + abs(dr.y);
    hi = max(hi, lineAA(dia - R4 * 0.62, 1.5));
    hi = max(hi, step(dia, R4 * 0.22));

    // Three square markers orbiting on the arc ring.
    for (int i = 0; i < 3; i++) {
        float ang = t * 0.09 + float(i) * 2.0944 + 0.4 * sin(t * 0.21 + float(i));
        vec2 mp = vec2(cos(ang), sin(ang)) * R2;
        vec2 md = abs(d - mp);
        float m = max(md.x, md.y);
        float s = 4.0 * sc;
        hi = max(hi, step(m, s) * step(s - 1.5, m));        // hollow square
        hi = max(hi, step(m, s * 0.35));                     // its centre dot
    }

    // The crosshair through the middle, dashed, faint.
    float ch = max(lineAA(d.y, 1.0), lineAA(d.x, 1.0)) * step(R4 * 1.4, r);
    ink = max(ink, ch * step(0.5, fract(r / (6.0 * sc))) * 0.35);
    return vec2(ink, hi);
}

// ---------------------------------------------------------------------------------------------

void main() {
    vec2 res = uResolution;
    float t = uTime;
    float tr = GLITCH * clamp(uTransition, 0.0, 1.0);   // the category-switch glitch, scaled
    float sc = max(1.0, floor(min(res.x, res.y) / 288.0));   // pixels per font dot (2 on the A55)
    int isc = int(sc);
    bool low = uBatteryLevel < 0.2;

    // The rebuild after a category switch: some rows slip sideways in whole font dots.
    vec2 px = gl_FragCoord.xy;
    if (tr > 0.01) {
        float row = floor(px.y / (6.0 * sc));
        float tick = floor(t * 18.0);
        float on = step(1.0 - 0.30 * tr, hash11(row * 7.13 + tick * 1.31));
        px.x += floor((hash11(row * 3.7 + tick) - 0.5) * 32.0 * tr) * sc * on;
    }
    ivec2 q = ivec2(floor(vec2(px.x, res.y - px.y)));   // pixel, y down
    vec2 uv = (px - 0.5 * res) / res.y;

    vec3 top = uColorTop.rgb, bot = uColorBottom.rgb;
    vec3 INK = uAccent.rgb;
    vec3 HI = low ? ALERT : uGlow.rgb;

    // Paper: the canvas gradient, a slow mottling and a fine grain.
    vec3 col = mix(bot, top, smoothstep(-0.55, 0.5, uv.y));
    col *= 0.93 + 0.10 * vnoise(uv * 2.6 + vec2(t * 0.004, 0.0));
    col *= 1.0 + (vnoise(px * 0.55) - 0.5) * 0.07;

    // Dot grid, with a registration cross every eighth dot.
    float g = 16.0 * sc;
    vec2 m = mod(px, g);
    if (m.x < sc && m.y < sc) col = mix(col, INK, 0.12);
    vec2 m2 = mod(px + 3.0 * sc, g * 8.0);
    if ((m2.x < 7.0 * sc && abs(m2.y - 3.5 * sc) < 0.5 * sc) || (m2.y < 7.0 * sc && abs(m2.x - 3.5 * sc) < 0.5 * sc))
        col = mix(col, INK, 0.22);

    // Rising data squares, two layers: the far one small and slow, the near one larger.
    for (int L = 0; L < 2; L++) {
        float fl = float(L);
        float cell = (34.0 + 26.0 * fl) * sc;
        vec2 p = px - vec2(0.0, t * (5.0 + 6.0 * fl) * sc);
        vec2 id = floor(p / cell);
        float h = hash21(id + fl * 17.0);
        if (h < 0.82) continue;
        vec2 f = p - id * cell;
        float s = (1.5 + floor(hash21(id + 3.1) * 3.0) + fl * 1.5) * sc;
        vec2 c0 = (0.22 + 0.56 * vec2(hash21(id + 1.7), hash21(id + 9.2))) * cell;
        vec2 dd = abs(f - c0);
        float sq = max(dd.x, dd.y);
        bool filled = hash21(id + 5.5) > 0.55;
        float on = filled ? step(sq, s) : step(sq, s) * step(s - sc, sq);
        float tw = 0.55 + 0.45 * sin(t * 0.7 + h * 60.0);
        col = mix(col, INK, on * (0.16 + 0.14 * fl) * tw);
    }

    // Frame geometry, shared by the scanner's readout and the frame below.
    int yTop = 30 * isc, yBot = int(res.y) - 26 * isc;
    int x0 = int(res.x * 0.36);

    // The scanner.
    {
        float aspect = res.x / res.y;
        vec2 c = aspect >= 1.0 ? vec2(max(0.5 * aspect - 0.40, 0.08), 0.0) : vec2(0.05, -0.18);
        float R = (aspect >= 1.0 ? 0.30 * res.y : 0.40 * res.x) * (1.0 + 0.025 * uAudioBass);
        vec2 d = px - (c * res.y + 0.5 * res);
        vec2 s = scanner(d, R, t, sc);
        col = mix(col, INK, s.x * 0.42);
        col = mix(col, HI, s.y * (0.62 + 0.2 * uAudioBass));
    }

    // Its label and a live readout, top right beside the header (the bottom right corner is where
    // Xross puts its button hints): "SECTOR 11 ~ SCAN" and "SYNC 9X.X%".
    {
        ivec2 o = ivec2(int(res.x) - labelWidth(4, isc) - 18 * isc, yTop + 10 * isc);
        col = mix(col, INK, label(q, 4, o, isc) * 0.55);
        ivec2 l = q - ivec2(int(res.x) - (10 * 6 - 1) * isc - 18 * isc, yTop + 19 * isc);
        if (l.x >= 0 && l.y >= 0 && l.y < 5 * isc && l.x < 10 * 6 * isc) {
            ivec2 dl = l / isc;
            int ci = dl.x / 6;
            int v = 870 + int(mod(floor(t * 3.1) * 7.0, 129.0));   // drifts between 87.0 and 99.8
            int gch = -1;
            if (ci < 4) gch = STR[STR_OFF[5] + ci];
            else if (ci == 5) gch = 26 + v / 100;
            else if (ci == 6) gch = 26 + (v / 10) % 10;
            else if (ci == 7) gch = 36;                  // "."
            else if (ci == 8) gch = 26 + v % 10;
            else if (ci == 9) gch = 52;                  // "%"
            col = mix(col, HI, dot5(gch, dl.x - ci * 6, dl.y) * 0.7);
        }
    }

    // Frame: rules near the top and bottom, a tick ruler and a hatched band under the top rule.
    {
        bool right = q.x >= x0;
        if (right && (q.y == yTop || q.y == yBot)) col = mix(col, INK, 0.45);
        if (right && q.y > yTop && q.y <= yTop + 3 * isc && (q.x - x0) % (8 * isc) < isc) col = mix(col, INK, 0.35);
        if (right && q.y > yTop && q.y <= yTop + 6 * isc && (q.x - x0) % (40 * isc) < isc) col = mix(col, INK, 0.45);
        // A short solid block where each rule starts, like a window's title tab.
        if (q.x >= x0 && q.x < x0 + 24 * isc && ((q.y >= yTop - 2 * isc && q.y < yTop) || (q.y > yBot && q.y <= yBot + 2 * isc)))
            col = mix(col, HI, 0.55);
        // Hatched band (45 degrees) on the right, under the ruler.
        if (q.x >= int(res.x * 0.70) && q.x < int(res.x) - 120 * isc && q.y > yTop + 9 * isc && q.y <= yTop + 13 * isc && (q.x + q.y) % (6 * isc) < 2 * isc)
            col = mix(col, INK, 0.16);

        // Header under the rule's start; the status line under it, after a small square.
        ivec2 ho = ivec2(x0 + 30 * isc, yTop + 10 * isc);
        col = mix(col, INK, label(q, 0, ho, isc) * 0.6);
        ivec2 so = ho + ivec2(9 * isc, 9 * isc);
        float blink = low ? 0.55 + 0.45 * sin(t * 2.0) : 1.0;      // a slow pulse, never a flash
        col = mix(col, low ? ALERT : INK, label(q, low ? 3 : 2, so, isc) * 0.5 * blink);
        ivec2 bo = q - ho - ivec2(0, 9 * isc);
        if (bo.x >= 0 && bo.x < 5 * isc && bo.y >= 0 && bo.y < 5 * isc) col = mix(col, low ? ALERT : HI, 0.6 * blink);

        // Ticker between the bottom rule and the edge.
        int ty = yBot + 9 * isc;
        if (q.x >= x0 && q.y >= ty && q.y < ty + 5 * isc) {
            float x = float(q.x - x0) / sc + t * TICKER_SPEED;
            float edge = smoothstep(0.0, 40.0 * sc, float(q.x - x0)) * smoothstep(0.0, 40.0 * sc, res.x - float(q.x));
            col = mix(col, INK, tickerDot(1, x, (q.y - ty) / isc) * 0.42 * edge);
        }
        // An "[ ARCHIVE ]" tab above the bottom rule's start.
        col = mix(col, INK, label(q, 6, ivec2(x0 + 30 * isc, yBot - 9 * isc), isc) * 0.5);
    }

    // Data column at the right edge: rows of cells that change a few times a second.
    {
        int cx = int(res.x) - 10 * isc;
        int cy0 = 30 * isc + 40 * isc, cy1 = int(res.y) - 40 * isc;
        if (q.x >= cx && q.x < cx + 4 * isc && q.y >= cy0 && q.y < cy1) {
            int row = (q.y - cy0) / (4 * isc);
            bool gap = (q.y - cy0) % (4 * isc) >= 3 * isc;
            float lit = step(0.58, hash21(vec2(float(row), floor(t * 2.0 + float(row) * 0.13))));
            if (!gap) col = mix(col, INK, 0.12 + 0.30 * lit);
        }
        // A bracket either side of the column.
        if ((q.y == cy0 || q.y == cy1) && q.x >= cx - 4 * isc && q.x < cx + 8 * isc) col = mix(col, INK, 0.45);
    }

    // Scan sweep: a hairline moving down the screen, with a faint wake above it.
    {
        float sy = fract(t / SWEEP_PERIOD) * res.y * 1.15 - 0.075 * res.y;
        float dy = float(q.y) - sy;
        float w = lineAA(dy, 1.0) * 0.30 + (dy < 0.0 ? exp(dy / (24.0 * sc)) * 0.05 : 0.0);
        col = mix(col, HI, w);
    }

    // The rebuild: blocks redrawn as outlines for a moment.
    if (tr > 0.01) {
        float b = 12.0 * sc;
        vec2 id = floor(px / b);
        vec2 f = mod(px, b);
        float on = step(hash21(id + floor(t * 14.0) * 0.731), tr * 0.22);
        float frame = (f.x < sc || f.y < sc) ? 1.0 : 0.25;
        col = mix(col, INK, on * frame * 0.4);
    }

    // Low battery: the paper takes a red cast.
    if (low) col = mix(col, col * vec3(1.15, 0.78, 0.70), 0.6);

    // Keep the menu's side calmer, and a light vignette.
    col *= mix(MENU_DIM, 1.0, smoothstep(0.06, 0.42, gl_FragCoord.x / res.x));
    col *= 1.0 - 0.30 * dot(uv, uv);

    // Dither so the soft gradients don't band.
    col += (hash21(gl_FragCoord.xy + fract(t)) - 0.5) / 255.0;
    fragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
}
