{
  "schemaVersion": 2,
  "name": "Default",
  "author": "Xross",
  "version": "2.0",
  "description": "The built-in look: XMB-style glyphs and console UI sounds. Packs in Xross/themes/ replace any part of it.",
  "imports": ["surfaces.json"],
  "wave": { "speed": 1.0, "lineCount": 5, "turbulence": 1.0, "ribbonThickness": 1.0 },
  "audio": {
    "sounds": {
      "cursor": "cursor.wav",
      "confirm": "cursor.wav",
      "option": "cursor.wav",
      "back": "back.wav",
      "ok": "ok.wav",
      "system_ng": "system_ng.wav",
      "trophy": "trophy.wav",
      "opening": "01. opening.wav",
      "gameboot": "gameboot.wav"
    },
    "soundGains": {
      "cursor": 0.5, "category_switch": 0.6, "confirm": 0.7, "option": 0.7, "back": 0.6,
      "ok": 0.6, "system_ng": 0.6, "trophy": 0.8
    }
  },
  "icons": {
    "album": "game_disc.svg",
    "artist": "users.svg",
    "shuffle": "refresh.svg"
  },
  "effects": { "surfaceStyle": "FLAT_GLASS" },
  "layout": {
    "crosshairX": 0.22,
    "crosshairY": 0.25,
    "cardAspectRatio": "16:9",
    "tile": { "music": "1:1", "photo": "1.3", "video": "1.3" },
    "itemSpacingDp": 12,
    "focusedScale": 1.32,
    "uiScale": 1.0,
    "focusDivider": "TITLE_UNDERLINE",
    "drillDownStyle": "BREADCRUMB",
    "textOverflow": "ELLIPSIS",
    "motionProfile": "CRISP"
  }
}
