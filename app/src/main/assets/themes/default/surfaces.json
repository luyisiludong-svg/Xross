      "fill": { "type": "SOLID", "color": "#000000", "opacity": 1.0 },
      "borders": [{ "type": "INNER", "widthDp": 1.0, "color": "#C9B8FF", "opacity": 0.9 }],
      "glow": { "color": "#C9B8FF", "radiusDp": 6, "intensity": 0.35 }
    },
    "EINK_HIGH_CONTRAST": {
      "label": "E-Ink high contrast",
      "shape": { "type": "RECTANGLE" },
      "fill": { "type": "SOLID", "color": "#000000", "opacity": 1.0 },
      "borders": [{ "type": "INNER", "widthDp": 2.0, "color": "#FFFFFF", "opacity": 1.0 }]
    }
